# ─────────────────────────────────────────────
#  CORPORATE LLM  (fill in your internal values)
# ─────────────────────────────────────────────
CORP_LLM_ENDPOINT=https://your-internal-llm-endpoint/v1/chat/completions
CORP_LLM_API_KEY=your-api-key-here
CORP_LLM_MODEL_NAME=gpt-4-internal          # or whatever your corp model is called
CORP_LLM_MAX_TOKENS=2048
CORP_LLM_TEMPERATURE=0.1                    # low = more deterministic for spec queries
CORP_LLM_TIMEOUT_SECONDS=60

# ─────────────────────────────────────────────
#  EMBEDDINGS  (runs locally — no data leaves)
# ─────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5      # best for technical/domain text
EMBEDDING_DEVICE=cpu                         # or "cuda" if GPU available
EMBEDDING_BATCH_SIZE=32

# ─────────────────────────────────────────────
#  NEO4J KNOWLEDGE GRAPH
# ─────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=5gsa

# ─────────────────────────────────────────────
#  VECTOR STORE  (choose one)
# ─────────────────────────────────────────────
VECTOR_STORE_BACKEND=chroma                 # "chroma" or "pgvector"

# If using pgvector:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vectordb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-pg-password

# If using chroma:
CHROMA_PERSIST_DIR=./data/chroma

# ─────────────────────────────────────────────
#  INGESTION
# ─────────────────────────────────────────────
DOCS_INPUT_DIR=./data/docs
CHUNK_SIZE=512                              # tokens per chunk
CHUNK_OVERLAP=64                            # overlap between chunks

# ─────────────────────────────────────────────
#  APP
# ─────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
